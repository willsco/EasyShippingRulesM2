<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Magento_Backend::stores">
                    <resource id="WillSco_EasyShippingRulesM2::easyshippingrules" title="Easy Shipping Rules" translate="title" sortOrder="50">
                        <resource id="WillSco_EasyShippingRulesM2::carrier" title="Carriers" translate="title" sortOrder="10"/>
                        <resource id="WillSco_EasyShippingRulesM2::custom_method" title="Custom Methods" translate="title" sortOrder="20"/>
                        <resource id="WillSco_EasyShippingRulesM2::existing_method" title="Existing Methods" translate="title" sortOrder="30"/>
                        <resource id="WillSco_EasyShippingRulesM2::rule" title="Rules" translate="title" sortOrder="40"/>
                        <resource id="WillSco_EasyShippingRulesM2::tester" title="Rule Tester" translate="title" sortOrder="50"/>
                    </resource>
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="WillSco_EasyShippingRulesM2::config" title="Easy Shipping Rules" translate="title"/>
                        </resource>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
