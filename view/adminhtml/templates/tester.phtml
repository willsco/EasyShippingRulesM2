$renderOptions = static function (array $options, string $selected) use (&$renderOptions, $escaper): string {
    $html = '';
    foreach ($options as $option) {
        $label = $escaper->escapeHtml(trim((string)$option['label']));
        if (is_array($option['value'])) {
            $html .= $option['value']
                ? '<optgroup label="' . $label . '">' . $renderOptions($option['value'], $selected) . '</optgroup>'
                : '';
            continue;
        }
        $value = (string)$option['value'];
        $html .= '<option value="' . $escaper->escapeHtmlAttr($value) . '"'
            . ($value === $selected ? ' selected="selected"' : '') . '>' . $label . '</option>';
    }
    return $html;
};

