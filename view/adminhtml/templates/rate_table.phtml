$preview = $block->getPreview();
?>
<?php if ($preview !== null): ?>
    <section class="admin__page-section esr-rate-table-preview">
        <div class="admin__page-section-title">
            <span class="title"><?= $escaper->escapeHtml(__('Review Before Importing')) ?></span>
        </div>
        <p>
            <?= $escaper->escapeHtml(__(
                '"%1" has %2 rate line(s) for %3 method(s). Nothing has been saved yet.',
                $block->getData('file_name'),
                $preview['rows'],
                count($preview['methods'])
            )) ?>
        </p>
        <?php if ($preview['new_carriers']): ?>
            <div class="message message-notice">
                <?= $escaper->escapeHtml(__('New carriers: %1', implode(', ', $preview['new_carriers']))) ?>
