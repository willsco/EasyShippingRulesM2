            <div class="admin__field">
                <div class="admin__field-control">
                    <button type="submit" class="action-primary">
                        <span><?= $escaper->escapeHtml(__('Confirm Import')) ?></span>
                    </button>
                    <button type="submit" name="cancel" value="1" class="action-secondary">
                        <span><?= $escaper->escapeHtml(__('Cancel')) ?></span>
                    </button>
                </div>
            </div>
        </form>
    </section>
<?php endif; ?>

