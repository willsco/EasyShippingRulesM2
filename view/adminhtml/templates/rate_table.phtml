        <?php endif; ?>
        <table class="data-grid">
            <thead>
            <tr>
                <th class="data-grid-th"><?= $escaper->escapeHtml(__('Method')) ?></th>
                <th class="data-grid-th"><?= $escaper->escapeHtml(__('Carriers')) ?></th>
                <th class="data-grid-th"><?= $escaper->escapeHtml(__('What Changes')) ?></th>
                <th class="data-grid-th"><?= $escaper->escapeHtml(__('Lines Now')) ?></th>
                <th class="data-grid-th"><?= $escaper->escapeHtml(__('Lines After')) ?></th>
                <th class="data-grid-th"><?= $escaper->escapeHtml(__('Lines Added')) ?></th>
                <th class="data-grid-th"><?= $escaper->escapeHtml(__('Lines Removed')) ?></th>
            </tr>
            </thead>
            <tbody>
            <?php foreach ($preview['methods'] as $method): ?>
                <?php
                if ($method['is_new']) {
                    $change = __('New method');
                } elseif ($method['added'] || $method['removed']) {
                    $change = __('Table changes');
                } elseif ($method['reordered']) {
                    $change = __('Same lines, new order');
                } else {
                    $change = __('No change');
                }
                ?>
                <tr>
                    <td><?= $escaper->escapeHtml($method['name']) ?></td>
                    <td><?= $escaper->escapeHtml(implode(', ', $method['carriers'])) ?></td>
                    <td><?= $escaper->escapeHtml($change) ?></td>
                    <td><?= (int)$method['rows_before'] ?></td>
                    <td><?= (int)$method['rows_after'] ?></td>
                    <td><?= (int)$method['added'] ?></td>
                    <td><?= (int)$method['removed'] ?></td>
                </tr>
            <?php endforeach; ?>
            </tbody>
        </table>
        <form action="<?= $escaper->escapeUrl($block->getImportUrl()) ?>" method="post">
            <input name="form_key" type="hidden" value="<?= $escaper->escapeHtmlAttr($block->getFormKey()) ?>"/>
