<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">easyshippingrules_custommethod_form.easyshippingrules_custommethod_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Custom Method</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <buttons>
            <button name="back" class="WillSco\EasyShippingRulesM2\Block\Adminhtml\Edit\BackButton"/>
            <button name="delete" class="WillSco\EasyShippingRulesM2\Block\Adminhtml\Edit\DeleteButton"/>
            <button name="save_and_continue" class="WillSco\EasyShippingRulesM2\Block\Adminhtml\Edit\SaveAndContinueButton"/>
            <button name="save" class="WillSco\EasyShippingRulesM2\Block\Adminhtml\Edit\SaveButton"/>
        </buttons>
        <namespace>easyshippingrules_custommethod_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>easyshippingrules_custommethod_form.easyshippingrules_custommethod_form_data_source</dep>
        </deps>
    </settings>
    <dataSource name="easyshippingrules_custommethod_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="easyshippingrules/custommethod/save"/>
        </settings>
        <dataProvider class="WillScoEsrCustomMethodFormDataProvider" name="easyshippingrules_custommethod_form_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>method_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="general" sortOrder="10">
        <settings>
            <label/>
        </settings>
        <field name="method_id" formElement="input">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">custom_method</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <visible>false</visible>
                <dataScope>method_id</dataScope>
            </settings>
        </field>
        <field name="is_active" sortOrder="10" formElement="checkbox">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">custom_method</item>
                    <item name="default" xsi:type="number">1</item>
                </item>
            </argument>
            <settings>
                <dataType>boolean</dataType>
                <label translate="true">Enabled</label>
                <dataScope>is_active</dataScope>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap>
                            <map name="false" xsi:type="number">0</map>
                            <map name="true" xsi:type="number">1</map>
                        </valueMap>
                        <prefer>toggle</prefer>
                    </settings>
                </checkbox>
            </formElements>
        </field>
        <field name="name" sortOrder="20" formElement="input">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">custom_method</item>
                </item>
            </argument>
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <dataType>text</dataType>
                <label translate="true">Name</label>
                <dataScope>name</dataScope>
                <notice translate="true">Shown as the shipping method title at checkout.</notice>
            </settings>
        </field>
        <field name="carrier_id" sortOrder="30" formElement="select">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">custom_method</item>
                </item>
            </argument>
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <dataType>text</dataType>
                <label translate="true">Carrier</label>
                <dataScope>carrier_id</dataScope>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="WillSco\EasyShippingRulesM2\Model\Source\Carrier"/>
                        <caption translate="true">-- Please Select --</caption>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="store_ids" sortOrder="40" formElement="multiselect">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">custom_method</item>
                    <item name="default" xsi:type="string">0</item>
                </item>
            </argument>
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <dataType>text</dataType>
                <label translate="true">Store View</label>
                <dataScope>store_ids</dataScope>
            </settings>
            <formElements>
                <multiselect>
                    <settings>
                        <options class="WillSco\EasyShippingRulesM2\Model\Source\StoreViews"/>
                    </settings>
                </multiselect>
            </formElements>
        </field>
        <field name="rule_ids" sortOrder="50" formElement="multiselect">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">custom_method</item>
                </item>
            </argument>
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <dataType>text</dataType>
                <label translate="true">Rules</label>
                <dataScope>rule_ids</dataScope>
                <notice translate="true">The method is offered when at least one of these rules is valid.</notice>
            </settings>
            <formElements>
                <multiselect>
                    <settings>
                        <options class="WillSco\EasyShippingRulesM2\Model\Source\Rule"/>
                    </settings>
                </multiselect>
            </formElements>
        </field>
    </fieldset>
    <fieldset name="pricing" sortOrder="20">
        <settings>
            <collapsible>true</collapsible>
            <opened>true</opened>
            <label translate="true">Price</label>
        </settings>
        <field name="calculation_type" sortOrder="10" formElement="select">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">custom_method</item>
                </item>
            </argument>
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <dataType>text</dataType>
                <label translate="true">Calculation Type</label>
                <dataScope>calculation_type</dataScope>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="WillSco\EasyShippingRulesM2\Model\Source\CalculationType"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="amount" sortOrder="20" formElement="input">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">custom_method</item>
                </item>
            </argument>
            <settings>
                <validation>
                    <rule name="validate-zero-or-greater" xsi:type="boolean">true</rule>
                </validation>
                <dataType>text</dataType>
                <label translate="true">Price / Percentage</label>
                <dataScope>amount</dataScope>
                <notice translate="true">Leave empty to use the Price / Percentage of the first valid rule.</notice>
            </settings>
        </field>
    </fieldset>
</form>
