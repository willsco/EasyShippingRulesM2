<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">easyshippingrules_carrier_form.easyshippingrules_carrier_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Carrier</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <buttons>
            <button name="back" class="WillSco\EasyShippingRulesM2\Block\Adminhtml\Edit\BackButton"/>
            <button name="delete" class="WillSco\EasyShippingRulesM2\Block\Adminhtml\Edit\DeleteButton"/>
            <button name="save_and_continue" class="WillSco\EasyShippingRulesM2\Block\Adminhtml\Edit\SaveAndContinueButton"/>
            <button name="save" class="WillSco\EasyShippingRulesM2\Block\Adminhtml\Edit\SaveButton"/>
        </buttons>
        <namespace>easyshippingrules_carrier_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>easyshippingrules_carrier_form.easyshippingrules_carrier_form_data_source</dep>
        </deps>
    </settings>
    <dataSource name="easyshippingrules_carrier_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="easyshippingrules/carrier/save"/>
        </settings>
        <dataProvider class="WillScoEsrCarrierFormDataProvider" name="easyshippingrules_carrier_form_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>carrier_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="general" sortOrder="10">
        <settings>
            <label/>
        </settings>
        <field name="carrier_id" formElement="input">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">carrier</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <visible>false</visible>
                <dataScope>carrier_id</dataScope>
            </settings>
        </field>
        <field name="is_active" sortOrder="10" formElement="checkbox">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">carrier</item>
                    <item name="default" xsi:type="number">1</item>
                </item>
            </argument>
            <settings>
                <dataType>boolean</dataType>
                <label translate="true">Enabled</label>
                <dataScope>is_active</dataScope>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap>
                            <map name="false" xsi:type="number">0</map>
                            <map name="true" xsi:type="number">1</map>
                        </valueMap>
                        <prefer>toggle</prefer>
                    </settings>
                </checkbox>
            </formElements>
        </field>
        <field name="name" sortOrder="20" formElement="input">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">carrier</item>
                </item>
            </argument>
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <dataType>text</dataType>
                <label translate="true">Name</label>
                <dataScope>name</dataScope>
                <notice translate="true">Shown as the carrier title at checkout.</notice>
            </settings>
        </field>
        <field name="sort_order" sortOrder="30" formElement="input">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">carrier</item>
                </item>
            </argument>
            <settings>
                <validation>
                    <rule name="validate-number" xsi:type="boolean">true</rule>
                </validation>
                <dataType>number</dataType>
                <label translate="true">Position</label>
                <dataScope>sort_order</dataScope>
                <notice translate="true">Carriers are sorted by position at checkout.</notice>
            </settings>
        </field>
    </fieldset>
</form>
