<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">easyshippingrules_existingmethod_listing.easyshippingrules_existingmethod_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <buttons>
            <button name="add">
                <url path="*/*/new"/>
                <class>primary</class>
                <label translate="true">Add New Existing Method</label>
            </button>
        </buttons>
        <spinner>easyshippingrules_existingmethod_columns</spinner>
        <deps>
            <dep>easyshippingrules_existingmethod_listing.easyshippingrules_existingmethod_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="easyshippingrules_existingmethod_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">method_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>WillSco_EasyShippingRulesM2::existing_method</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider" name="easyshippingrules_existingmethod_listing_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>method_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filters name="listing_filters"/>
        <massaction name="listing_massaction" component="Magento_Ui/js/grid/tree-massactions">
            <action name="delete">
                <settings>
                    <confirm>
                        <message translate="true">Are you sure you want to delete the selected items?</message>
                        <title translate="true">Delete items</title>
                    </confirm>
                    <url path="*/*/massDelete"/>
                    <type>delete</type>
                    <label translate="true">Delete</label>
                </settings>
            </action>
            <action name="is_active">
                <settings>
                    <type>is_active</type>
                    <label translate="true">Change Status</label>
                    <actions class="WillScoEsrStatusMassOptions"/>
                </settings>
            </action>
            <action name="action_type">
                <settings>
                    <type>action_type</type>
                    <label translate="true">Change Action</label>
                    <actions class="WillScoEsrActionTypeMassOptions"/>
                </settings>
            </action>
            <action name="calculation_type">
                <settings>
                    <type>calculation_type</type>
                    <label translate="true">Change Calculation Type</label>
                    <actions class="WillScoEsrExistingCalculationTypeMassOptions"/>
                </settings>
            </action>
        </massaction>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="easyshippingrules_existingmethod_columns">
        <selectionsColumn name="ids">
            <settings>
                <indexField>method_id</indexField>
            </settings>
        </selectionsColumn>
        <column name="method_id" sortOrder="10">
            <settings>
                <filter>textRange</filter>
                <label translate="true">ID</label>
                <sorting>asc</sorting>
            </settings>
        </column>
        <column name="name" sortOrder="20">
            <settings>
                <filter>text</filter>
                <label translate="true">Name</label>
            </settings>
        </column>
        <column name="carrier_title" sortOrder="30">
            <settings>
                <filter>text</filter>
                <label translate="true">Carrier Title</label>
            </settings>
        </column>
        <column name="method_title" sortOrder="40">
            <settings>
                <filter>text</filter>
                <label translate="true">Method Title</label>
            </settings>
        </column>
        <column name="is_active" component="Magento_Ui/js/grid/columns/select" sortOrder="50">
            <settings>
                <options class="WillSco\EasyShippingRulesM2\Model\Source\Status"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Status</label>
            </settings>
        </column>
        <column name="action_type" component="Magento_Ui/js/grid/columns/select" sortOrder="60">
            <settings>
                <options class="WillSco\EasyShippingRulesM2\Model\Source\ActionType"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Action</label>
            </settings>
        </column>
        <column name="calculation_type" component="Magento_Ui/js/grid/columns/select" sortOrder="70">
            <settings>
                <options class="WillScoEsrExistingCalculationType"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Calculation Type</label>
            </settings>
        </column>
        <column name="amount" sortOrder="80">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Price / Percentage</label>
            </settings>
        </column>
        <column name="created_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date" sortOrder="900">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Created</label>
                <visible>false</visible>
            </settings>
        </column>
        <column name="updated_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date" sortOrder="910">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Modified</label>
                <visible>false</visible>
            </settings>
        </column>
        <actionsColumn name="actions" class="WillSco\EasyShippingRulesM2\Ui\Component\Listing\Column\RowActions" sortOrder="1000">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="urlPrefix" xsi:type="string">easyshippingrules/existingmethod</item>
                </item>
            </argument>
            <settings>
                <indexField>method_id</indexField>
            </settings>
        </actionsColumn>
    </columns>
</listing>
